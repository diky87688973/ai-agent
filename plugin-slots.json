{
  "version": 1,
  "root": "app",
  "owners": {
    "app/shell/web-ui": "web_ui",
    "app/settings/agent": "base_settings",
    "app/settings/context": "base_settings",
    "app/settings/interface": "base_settings",
    "app/settings/plugin": "base_settings",
    "app/settings/model": "multi_model"
  },
  "slots": [
    {"path": "app/kernel", "kind": "container", "owner": "__host__"},

    {"path": "app/kernel/modules", "kind": "container", "owner": "__host__",
     "factory": "agent.boot.components:make_kernel_group"},
    {"path": "app/kernel/modules/input", "kind": "module", "scope": "session",
     "factory": "agent.core.modules.slot_chain:input_module", "order": 0},
    {"path": "app/kernel/modules/queued_input", "kind": "module", "scope": "session",
     "factory": "agent.core.modules.slot_chain:queued_input_module", "order": 1},
    {"path": "app/kernel/modules/compress", "kind": "module", "scope": "session",
     "factory": "agent.core.modules.slot_chain:compress_module", "order": 2},
    {"path": "app/kernel/modules/model", "kind": "module", "scope": "session",
     "factory": "agent.core.modules.slot_chain:model_module", "order": 3},
    {"path": "app/kernel/modules/tool", "kind": "module", "scope": "session",
     "factory": "agent.core.modules.slot_chain:tool_module", "order": 4},

    {"path": "app/host", "kind": "container", "owner": "__host__"},
    {"path": "app/host/services", "kind": "container", "owner": "__host__"},

    {"path": "app/host/services/event_bus", "kind": "service",
     "factory": "agent.boot.host_factories:make_event_bus"},
    {"path": "app/host/services/error_log", "kind": "service",
     "factory": "agent.boot.host_factories:make_error_log",
     "requires": {"event_bus": "app/host/services/event_bus"}},
    {"path": "app/host/services/live_state", "kind": "service",
     "factory": "agent.boot.host_factories:make_live_state"},
    {"path": "app/host/services/queue", "kind": "service",
     "factory": "agent.boot.host_factories:make_queue",
     "requires": {"event_bus": "app/host/services/event_bus"}},
    {"path": "app/host/services/mesh", "kind": "service",
     "factory": "agent.boot.host_factories:make_mesh",
     "requires": {"queue": "app/host/services/queue"}},
    {"path": "app/host/services/registry", "kind": "service",
     "factory": "agent.boot.host_factories:make_registry"},
    {"path": "app/host/services/background_tasks", "kind": "service",
     "factory": "agent.boot.host_factories:make_background_tasks"},
    {"path": "app/host/services/context_sources", "kind": "service",
     "factory": "agent.boot.host_factories:make_context_sources"},
    {"path": "app/host/services/context_hooks", "kind": "service",
     "factory": "agent.boot.host_factories:make_context_hooks"},
    {"path": "app/host/services/prompt_tail", "kind": "service",
     "factory": "agent.boot.host_factories:make_prompt_tail"},
    {"path": "app/host/services/prompt_sections", "kind": "service",
     "factory": "agent.boot.host_factories:make_prompt_sections"},
    {"path": "app/host/services/contributions", "kind": "service",
     "factory": "agent.boot.host_factories:make_contributions"},
    {"path": "app/host/services/model_catalog", "kind": "service",
     "factory": "agent.boot.host_factories:make_model_catalog"},
    {"path": "app/host/services/update", "kind": "service",
     "factory": "agent.boot.host_factories:make_update"},
    {"path": "app/host/services/session_factory", "kind": "service",
     "factory": "agent.boot.host_factories:make_session_factory",
     "requires": {"context_sources": "app/host/services/context_sources"}},
    {"path": "app/host/services/compactor_factory", "kind": "service",
     "factory": "agent.boot.host_factories:make_compactor_factory",
     "requires": {"provider": "app/host/services/provider"}},
    {"path": "app/host/services/provider", "kind": "service",
     "factory": "agent.boot.host_factories:make_provider",
     "requires": {"model_catalog": "app/host/services/model_catalog"}},
    {"path": "app/host/services/contexts", "kind": "service",
     "factory": "agent.boot.host_factories:make_contexts",
     "requires": {"registry": "app/host/services/registry",
                  "live_state": "app/host/services/live_state"}},
    {"path": "app/host/services/pipeline", "kind": "service",
     "factory": "agent.boot.host_factories:make_pipeline",
     "requires": {"registry": "app/host/services/registry",
                  "contexts": "app/host/services/contexts",
                  "live_state": "app/host/services/live_state"}},
    {"path": "app/host/services/plugin_host", "kind": "service",
     "factory": "agent.boot.host_factories:make_plugin_host",
     "requires": {"registry": "app/host/services/registry",
                  "event_bus": "app/host/services/event_bus",
                  "context_sources": "app/host/services/context_sources",
                  "pipeline": "app/host/services/pipeline",
                  "contributions": "app/host/services/contributions",
                  "context_hooks": "app/host/services/context_hooks",
                  "model_catalog": "app/host/services/model_catalog",
                  "prompt_tail": "app/host/services/prompt_tail",
                  "prompt_sections": "app/host/services/prompt_sections"}},
    {"path": "app/host/services/store", "kind": "service",
     "factory": "agent.boot.host_factories:make_store"},
    {"path": "app/host/services/subagents", "kind": "service",
     "factory": "agent.boot.host_factories:make_subagents",
     "requires": {"store": "app/host/services/store",
                  "mesh": "app/host/services/mesh",
                  "queue": "app/host/services/queue",
                  "event_bus": "app/host/services/event_bus"}},

    {"path": "app/boot", "kind": "container", "owner": "__host__"},
    {"path": "app/boot/files", "kind": "service",
     "factory": "agent.boot.components:make_files"},
    {"path": "app/boot/facade", "kind": "service",
     "factory": "agent.boot.components:make_facade",
     "requires": {
       "event_bus": "app/host/services/event_bus",
       "error_log": "app/host/services/error_log",
       "live_state": "app/host/services/live_state",
       "conversation_queue": "app/host/services/queue",
       "mesh": "app/host/services/mesh",
       "registry": "app/host/services/registry",
       "background_tasks": "app/host/services/background_tasks",
       "context_sources": "app/host/services/context_sources",
       "context_hooks": "app/host/services/context_hooks",
       "prompt_tail": "app/host/services/prompt_tail",
       "prompt_sections": "app/host/services/prompt_sections",
       "contributions": "app/host/services/contributions",
       "model_catalog": "app/host/services/model_catalog",
       "update": "app/host/services/update",
       "session_factory": "app/host/services/session_factory",
       "compactor_factory": "app/host/services/compactor_factory",
       "provider": "app/host/services/provider",
       "session_contexts": "app/host/services/contexts",
       "pipeline": "app/host/services/pipeline",
       "plugin_host": "app/host/services/plugin_host",
       "store": "app/host/services/store",
       "subagents": "app/host/services/subagents"
     }},
    {"path": "app/boot/plugins", "kind": "service",
     "factory": "agent.boot.components:make_plugins",
     "requires": {"facade": "app/boot/facade"}},

    {"path": "app/boot/tools", "kind": "container",
     "factory": "agent.boot.tool_components:tool_group",
     "requires": {"registry": "app/host/services/registry"}},

    {"path": "app/boot/tools/background_task", "kind": "tool", "order": 0,
     "factory": "agent.boot.tool_components:make_background_task",
     "requires": {"background_tasks": "app/host/services/background_tasks",
                  "live_state": "app/host/services/live_state"}},
    {"path": "app/boot/tools/echo", "kind": "tool", "order": 1,
     "factory": "agent.boot.tool_components:make_echo"},
    {"path": "app/boot/tools/read_file", "kind": "tool", "order": 2,
     "factory": "agent.boot.tool_components:make_read_file"},
    {"path": "app/boot/tools/grep_files", "kind": "tool", "order": 3,
     "factory": "agent.boot.tool_components:make_grep_files"},
    {"path": "app/boot/tools/glob_files", "kind": "tool", "order": 4,
     "factory": "agent.boot.tool_components:make_glob_files"},
    {"path": "app/boot/tools/write_file", "kind": "tool", "order": 5,
     "factory": "agent.boot.tool_components:make_write_file"},
    {"path": "app/boot/tools/replace_in_file", "kind": "tool", "order": 6,
     "factory": "agent.boot.tool_components:make_replace_in_file"},
    {"path": "app/boot/tools/apply_patch", "kind": "tool", "order": 7,
     "factory": "agent.boot.tool_components:make_apply_patch"},
    {"path": "app/boot/tools/read_write", "kind": "tool", "order": 8,
     "factory": "agent.boot.tool_components:make_read_write"},
    {"path": "app/boot/tools/delete_file", "kind": "tool", "order": 9,
     "factory": "agent.boot.tool_components:make_delete_file",
     "requires": {"files": "app/boot/files"}},
    {"path": "app/boot/tools/file_ops", "kind": "tool", "order": 10,
     "factory": "agent.boot.tool_components:make_file_ops"},
    {"path": "app/boot/tools/file_undo", "kind": "tool", "order": 11,
     "factory": "agent.boot.tool_components:make_file_undo",
     "requires": {"files": "app/boot/files"}},
    {"path": "app/boot/tools/run_command", "kind": "tool", "order": 12,
     "factory": "agent.boot.tool_components:make_run_command",
     "requires": {"live_state": "app/host/services/live_state"}},
    {"path": "app/boot/tools/python_inline", "kind": "tool", "order": 13,
     "factory": "agent.boot.tool_components:make_python_inline",
     "requires": {"live_state": "app/host/services/live_state"}},
    {"path": "app/boot/tools/run_type", "kind": "tool", "order": 14,
     "factory": "agent.boot.tool_components:make_run_type",
     "requires": {"live_state": "app/host/services/live_state"}},
    {"path": "app/boot/tools/todo_list", "kind": "tool", "order": 15,
     "factory": "agent.boot.tool_components:make_todo_list",
     "requires": {"live_state": "app/host/services/live_state"}},
    {"path": "app/boot/tools/user_confirm", "kind": "tool", "order": 16,
     "factory": "agent.boot.tool_components:make_user_confirm"},
    {"path": "app/boot/tools/approval_confirm", "kind": "tool", "order": 17,
     "factory": "agent.boot.tool_components:make_approval_confirm"},
    {"path": "app/boot/tools/goal", "kind": "tool", "order": 18,
     "factory": "agent.boot.tool_components:make_goal",
     "requires": {"live_state": "app/host/services/live_state"}},
    {"path": "app/boot/tools/task_sleep", "kind": "tool", "order": 19,
     "factory": "agent.boot.tool_components:make_task_sleep"},
    {"path": "app/boot/tools/task_schedule", "kind": "tool", "order": 20,
     "factory": "agent.boot.tool_components:make_task_schedule"},
    {"path": "app/boot/tools/task_wake_cancel", "kind": "tool", "order": 21,
     "factory": "agent.boot.tool_components:make_task_wake_cancel"},
    {"path": "app/boot/tools/task_wake_list", "kind": "tool", "order": 22,
     "factory": "agent.boot.tool_components:make_task_wake_list"},
    {"path": "app/boot/tools/session_send", "kind": "tool", "order": 23,
     "factory": "agent.boot.tool_components:make_session_send",
     "requires": {"mesh": "app/host/services/mesh"}},
    {"path": "app/boot/tools/session_multisend", "kind": "tool", "order": 24,
     "factory": "agent.boot.tool_components:make_session_multisend",
     "requires": {"mesh": "app/host/services/mesh"}},
    {"path": "app/boot/tools/session_broadcast", "kind": "tool", "order": 25,
     "factory": "agent.boot.tool_components:make_session_broadcast",
     "requires": {"mesh": "app/host/services/mesh"}},
    {"path": "app/boot/tools/session_create", "kind": "tool", "order": 26,
     "factory": "agent.boot.tool_components:make_session_create",
     "requires": {"mesh": "app/host/services/mesh"}},
    {"path": "app/boot/tools/session_list", "kind": "tool", "order": 27,
     "factory": "agent.boot.tool_components:make_session_list",
     "requires": {"mesh": "app/host/services/mesh"}},
    {"path": "app/boot/tools/find_in_file", "kind": "tool", "order": 28,
     "factory": "agent.boot.tool_components:make_find_in_file"},
    {"path": "app/boot/tools/regex_locate", "kind": "tool", "order": 29,
     "factory": "agent.boot.tool_components_media:make_regex_locate"},
    {"path": "app/boot/tools/subagent", "kind": "tool", "order": 30,
     "factory": "agent.boot.tool_components:make_subagent",
     "requires": {"subagents": "app/host/services/subagents"}},
    {"path": "app/boot/tools/subagent_send", "kind": "tool", "order": 31,
     "factory": "agent.boot.tool_components:make_subagent_send",
     "requires": {"subagents": "app/host/services/subagents"}},
    {"path": "app/boot/tools/file_search", "kind": "tool", "order": 32,
     "factory": "agent.boot.tool_components_media:make_file_search"},
    {"path": "app/boot/tools/text_diff", "kind": "tool", "order": 33,
     "factory": "agent.boot.tool_components:make_text_diff"},
    {"path": "app/boot/tools/data_table", "kind": "tool", "order": 34,
     "factory": "agent.boot.tool_components_media:make_data_table"},
    {"path": "app/boot/tools/unified_diagnose", "kind": "tool", "order": 35,
     "factory": "agent.boot.tool_components_media:make_unified_diagnose"},
    {"path": "app/boot/tools/git_workspace", "kind": "tool", "order": 36,
     "factory": "agent.boot.tool_components_media:make_git_workspace"},
    {"path": "app/boot/tools/web_fetch", "kind": "tool", "order": 37,
     "factory": "agent.boot.tool_components_media:make_web_fetch"},
    {"path": "app/boot/tools/web_fetch_render", "kind": "tool", "order": 38,
     "factory": "agent.boot.tool_components_media:make_web_fetch_render"},
    {"path": "app/boot/tools/image_ocr", "kind": "tool", "order": 39,
     "factory": "agent.boot.tool_components_media:make_image_ocr"},
    {"path": "app/boot/tools/read_image", "kind": "tool", "order": 40,
     "factory": "agent.boot.tool_components_media:make_read_image"},
    {"path": "app/boot/tools/archive", "kind": "tool", "order": 41,
     "factory": "agent.boot.tool_components_media:make_archive"},
    {"path": "app/boot/tools/ip_geolocate", "kind": "tool", "order": 42,
     "factory": "agent.boot.tool_components_media:make_ip_geolocate"},
    {"path": "app/boot/tools/open_meteo_weather", "kind": "tool", "order": 43,
     "factory": "agent.boot.tool_components_media:make_open_meteo_weather"},
    {"path": "app/boot/tools/commit_write", "kind": "tool", "order": 44,
     "factory": "agent.boot.tool_components:make_commit_write",
     "requires": {"executors": "app/boot/tools/executors"}},
    {"path": "app/boot/tools/review_conclusion", "kind": "tool", "order": 45,
     "factory": "agent.boot.tool_components:make_review_conclusion"},
    {"path": "app/boot/tools/present", "kind": "tool", "order": 46,
     "factory": "agent.boot.tool_components:make_present"},

    {"path": "app/boot/tools/executors", "kind": "service",
     "factory": "agent.boot.tool_components:make_executors",
     "requires": {"files": "app/boot/files"}},

    {"path": "app/boot/shell", "kind": "container", "owner": "__host__"},
    {"path": "app/boot/shell/classic_adapter", "kind": "service",
     "factory": "agent.boot.shell_components:classic_adapter",
     "requires": {"facade": "app/boot/facade"}},
    {"path": "app/boot/shell/plugin_events", "kind": "service",
     "factory": "agent.boot.shell_components:plugin_events",
     "requires": {"classic_adapter": "app/boot/shell/classic_adapter"}},
    {"path": "app/boot/shell/runner", "kind": "service",
     "factory": "agent.boot.shell_components:runner",
     "requires": {"facade": "app/boot/facade"}},
    {"path": "app/boot/shell/wake_scheduler", "kind": "service",
     "factory": "agent.boot.shell_components:wake_scheduler",
     "requires": {"facade": "app/boot/facade"}},
    {"path": "app/boot/shell/finalizer", "kind": "service",
     "factory": "agent.boot.shell_components:finalizer",
     "requires": {"facade": "app/boot/facade",
                  "classic_adapter": "app/boot/shell/classic_adapter",
                  "plugin_events": "app/boot/shell/plugin_events",
                  "runner": "app/boot/shell/runner",
                  "wake_scheduler": "app/boot/shell/wake_scheduler"}},

    {"path": "app/auth", "kind": "container", "owner": "auth",
     "frozen": true}
  ]
}
