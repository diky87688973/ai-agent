{
  "version": 1,
  "kind": "settings",
  "settings": {
    "panels": [
      {
        "id": "app/settings/agent",
        "title": "Agent"
      },
      {
        "id": "app/settings/context",
        "title": "上下文"
      },
      {
        "id": "app/settings/interface",
        "title": "界面"
      },
      {
        "id": "app/settings/plugin",
        "title": "插件设置"
      }
    ],
    "fields": [
      {
        "panel": "app/settings/agent",
        "key": "reasoning_effort",
        "section": "agent",
        "kind": "select",
        "label": "推理档位",
        "default": "high",
        "options": [
          {
            "value": "high",
            "label": "high"
          },
          {
            "value": "max",
            "label": "max"
          }
        ]
      },
      {
        "panel": "app/settings/agent",
        "key": "max_passes",
        "section": "agent",
        "kind": "number",
        "label": "每回合往返上限",
        "default": "512",
        "hint": "每回合往返上限≠每回合工具调用次数上限，每次往返可调用 0 个或多个工具",
        "min": 1
      },
      {
        "panel": "app/settings/agent",
        "key": "backup_retention_days",
        "section": "agent",
        "kind": "number",
        "label": "AI 修改文件时的备份保存天数",
        "default": "7",
        "min": 0
      },
      {
        "panel": "app/settings/context",
        "key": "full_user_rounds",
        "section": "context",
        "kind": "number",
        "label": "压缩时保留最近对话轮数",
        "default": "5",
        "min": 0
      },
      {
        "panel": "app/settings/context",
        "key": "summary_output_max_chars",
        "section": "context",
        "kind": "number",
        "label": "摘要字数上限",
        "default": "5000",
        "min": 1
      },
      {
        "panel": "app/settings/context",
        "key": "reasoning_replay_tokens",
        "section": "context",
        "kind": "number",
        "label": "思维链回传预算",
        "default": "8000",
        "min": -1
      },
      {
        "panel": "app/settings/context",
        "key": "image_turns",
        "section": "context",
        "kind": "number",
        "label": "带图用户轮数",
        "default": "1",
        "min": 0
      },
      {
        "panel": "app/settings/context",
        "key": "image_max",
        "section": "context",
        "kind": "number",
        "label": "带图张数上限",
        "default": "8",
        "min": 0
      },
      {
        "panel": "app/settings/interface",
        "key": "display_tool_items",
        "kind": "checkbox",
        "label": "工作区展示工具步骤",
        "default": "1",
        "section": "web-ui"
      },
      {
        "panel": "app/settings/interface",
        "key": "display_tool_steps",
        "kind": "checkbox",
        "label": "侧边栏展示工具步骤",
        "default": "0",
        "section": "web-ui"
      }
    ],
