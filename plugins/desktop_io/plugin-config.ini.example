; 桌面 IO 插件配置。
; [base] 每个插件都有：身份与开关。
; [ext] 只放这个插件自己的键。

[base]
id = desktop_io
name = 桌面 IO
desc = 看屏（截屏）与操作鼠标、键盘。
; 1 装载，0 留在清单里但不装载。没写时按 1。
enable = 1
icon = 🖥️
version = 1.0

[ext]
; 四个能力各自开关：关掉后对应工具不注册。
eye = 1
mouse = 1
keyboard = 1
wait = 1
; 发给模型前把长边缩到不超过该像素；0 = 不缩放。
max_side = 1600
; 坐标网格间距（屏幕坐标单位）。
grid_step = 100
; 截图时画光标十字。
cursor_mark = 1
; 输入动作后等待界面响应的毫秒数。
settle_ms = 60
; type 每个字符之间的毫秒数。
type_interval_ms = 12
; desktop_eye 用 hover 时，移完光标等界面展开的毫秒数。
hover_settle_ms = 250
; desktop_wait 的默认轮询间隔（毫秒）。
wait_interval_ms = 200
