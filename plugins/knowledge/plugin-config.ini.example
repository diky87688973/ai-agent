; 知识库插件配置。
; [base] 每个插件都有：身份与开关。
; [ext] 只放这个插件自己的键。

[base]
id = knowledge
name = 知识库
desc = 把勾选的资料注入当前会话。
; 1 装载，0 留在清单里但不装载。没写时按 1。
enable = 1
icon = 📚
version = 1.0

[ext]
; 知识库文件目录。留空或目录不存在则不提供任何文件；相对路径按工程根解析。
; 只收文本类文件（.md/.txt/.csv/.json/.yaml/源码等，见插件里的 TEXT_SUFFIXES），
; `.xlsx/.xls/.xlsm` 按表格解析（需要 openpyxl）；图片、压缩包等非文本文件
; 不列出也不可勾选 —— 读出来是替换字符与 NUL，注进上下文只占预算。
dir =
; 单个文件的字节上限，超过则不读入上下文
max_file_size = 200000
; 额外收录的扩展名：英文逗号分隔，带不带点都认（txt, ini 与 .txt,.ini 等价）。
; 用来收上面清单之外的文本类型；写错不影响其它配置。
extra_suffixes =
