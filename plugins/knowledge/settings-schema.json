{
  "kind": "fields",
  "title": "知识库配置",
  "section": "config",
  "fields": [
    {
      "key": "dir",
      "kind": "text",
      "label": "目录",
      "placeholder": "示例: D:/knowledge_base",
      "hint": "知识库目录"
    },
    {
      "key": "max_file_size",
      "kind": "number",
      "label": "单文件上限（字节）",
      "default": "200000",
      "min": 1
    },
    {
      "key": "extra_suffixes",
      "kind": "text",
      "label": "额外扩展名",
      "hint": "文件未被识别时可在此配置后缀名",
      "placeholder": "示例: txt, ini"
    }
  ]
}
