; 多模型插件配置模板。实际配置为同目录的 plugin-config.ini（已被 .gitignore 忽略）。
; 设置页「插件 → 设置」里也能直接编辑；没有 plugin-config.ini 时会先填入本示例。
;
; [base] 是插件身份与开关；[model:<id>] 每条模型一节。
; id 是请求与界面里的唯一标识，必须唯一；model 缺省等于 id。
; provider 缺省 openai；api_key / base_url 缺失会让该条目无效，但不影响其它条目。
; default = 1 至多一个；没写时取第一条有效条目。
; thinking / max_tokens / thinking_budget_tokens 只对 anthropic 条目生效：
;   max_tokens            回复的 token 上限（该协议必填，不是上下文长度）
;   thinking              1 = 开，0 = 关；0 会显式下发 disabled（DeepSeek 默认是开的）
;   thinking_budget_tokens 思考预算；Anthropic 官方按它控深度且必须 < max_tokens，
;                         DeepSeek 兼容层按官方文档忽略这个值（深度取服务端默认 high）
;
; context_window 是该模型的上下文窗口（token）：界面按它算上下文占用率。
;   每个模型的物理上限不同（128000 / 256000 / 1000000），换模型时同步修改。
;   它是物理上限，与 [context] 的压缩阈值（预算）不是一回事；不写时按 1000000 算。
;
; base_url 指向持有这把密钥的网关：DeepSeek 的 key 配到 api.anthropic.com
; 会被 Anthropic 以 403 `Request not allowed` 拒绝。
;
; 同一家厂商同时走两套协议时，用不同的 id 各写一节（id 不能重复）：
;   provider 决定协议与端点拼法，model 决定发给网关的线格式模型名。
;   [model:deepseek-openai]     provider = openai
;   [model:deepseek-anthropic]  provider = anthropic
; 下面两段是这种形态的示例，默认注释掉。
;
; [model:deepseek-openai]
; provider = openai
; base_url = https://api.deepseek.com
; api_key = sk-请替换
; model = deepseek-flash
; label = DeepSeek（OpenAI 协议）
;
; [model:deepseek-anthropic]
; provider = anthropic
; base_url = https://api.deepseek.com/anthropic
; api_key = sk-请替换
; model = deepseek-flash
; label = DeepSeek（Anthropic 协议）
; max_tokens = 16000
;
; 诊断格式：[plugin:multi_model] <文件路径> [model:<id>] <键> 无效：<原因>
; 条目改完下一次请求即生效，不需要重启。

[base]
id = multi_model
enable = 1
name = 多模型
icon = 🧠
version = 1.0
desc = 支持配置多个模型网关

[model:deepseek]
provider = openai
base_url = https://api.deepseek.com
api_key = sk-请替换
model = deepseek-flash
label = DeepSeek Flash
context_window = 1000000
default = 1

[model:claude]
provider = anthropic
base_url = https://api.anthropic.com
api_key = sk-ant-请替换
model = claude-sonnet-4-5
label = Claude Sonnet 4.5
context_window = 200000
max_tokens = 16000
thinking = 1
thinking_budget_tokens = 4096
