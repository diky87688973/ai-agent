{
  "kind": "sections",
  "title": "模型",
  "section_prefix": "model:",
  "add_label": "添加模型",
  "empty_text": "还没有模型。至少添加一条，填上网关与密钥。",
  "identity": {
    "key": "id",
    "label": "配置 ID",
    "hint": "请求与界面使用的唯一标识，不是模型名"
  },
  "fields": [
    {
      "key": "provider",
      "kind": "enum",
      "label": "协议",
      "default": "openai",
      "options": [
        {
          "value": "openai",
          "label": "OpenAI（Chat Completions）"
        },
        {
          "value": "anthropic",
          "label": "Anthropic（Messages）"
        }
      ]
    },
    {
      "key": "base_url",
      "kind": "text",
      "label": "网关地址",
      "placeholder": "示例: https://..."
    },
    {
      "key": "api_key",
      "kind": "secret",
      "label": "API 密钥",
      "placeholder": "示例: sk-..."
    },
    {
      "key": "model",
      "kind": "text",
      "label": "模型名",
      "hint": "与模型提供商保持一致"
    },
    {
      "key": "label",
