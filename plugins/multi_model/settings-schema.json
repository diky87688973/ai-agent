{
  "kind": "sections",
  "title": "模型",
  "section_prefix": "model:",
  "add_label": "添加模型",
  "empty_text": "还没有模型。至少添加一条，填上网关与密钥。",
  "identity": {
    "key": "id",
    "label": "配置 ID",
    "hint": "请求与界面使用的唯一标识，不是模型名"
  },
  "fields": [
    {
      "key": "provider",
      "kind": "enum",
      "label": "协议",
      "default": "openai",
      "options": [
        {
          "value": "openai",
          "label": "OpenAI（Chat Completions）"
        },
        {
          "value": "anthropic",
          "label": "Anthropic（Messages）"
        }
      ]
    },
    {
      "key": "base_url",
      "kind": "text",
      "label": "网关地址",
      "placeholder": "示例: https://..."
    },
    {
      "key": "api_key",
      "kind": "secret",
      "label": "API 密钥",
      "placeholder": "示例: sk-..."
    },
    {
      "key": "model",
      "kind": "text",
      "label": "模型名",
      "hint": "与模型提供商保持一致"
    },
    {
      "key": "label",
      "kind": "text",
      "label": "显示名称",
      "placeholder": "示例: Model A"
    },
    {
      "key": "context_window",
      "kind": "number",
      "label": "上下文窗口（token）",
      "min": 1,
      "hint": "模型供应商声明的最大上下文窗口"
    },
    {
      "key": "default",
      "kind": "bool",
      "label": "默认模型"
    },
    {
      "key": "max_tokens",
      "kind": "number",
      "label": "回复上限（token）",
      "min": 1,
      "show_if": {
        "key": "provider",
        "equals": "anthropic"
      },
      "default": "16000",
      "placeholder": "示例: 16000"
    },
    {
      "key": "thinking",
      "kind": "bool",
      "label": "启用深度思考",
      "show_if": {
        "key": "provider",
        "equals": "anthropic"
      }
    },
    {
      "key": "thinking_budget_tokens",
      "kind": "number",
      "label": "思考预算（token）",
      "min": 1,
      "show_if": {
        "key": "provider",
        "equals": "anthropic"
      },
      "default": "4096",
      "placeholder": "示例: 4096"
    }
  ],
  "identity_mode": "index"
}
