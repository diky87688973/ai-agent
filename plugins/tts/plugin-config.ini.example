; TTS 插件配置。
; [base] 每个插件都有：身份与开关。
; [ext] 只放这个插件自己的键。

[base]
id = tts
name = 语音
desc = 把回答切成句子后朗读。
; 1 装载，0 留在清单里但不装载。没写时按 1。
enable = 0
icon = 🔊
version = 1.0

[ext]
; 引擎：console（只打印文本，不出声）/ edge（需 pip install edge-tts）
engine = edge
; 音色名
voice = zh-CN-XiaoxiaoNeural
; 单段文本上限（字数，取值 40–2000），超出则切分
max_segment_chars = 240
