{
  "version": 1,
  "root": "app",
  "slots": [
    {"path": "app/shell/web-ui", "kind": "ui-slot", "children": "fixed", "fixed": ["nav", "chat", "input", "left-panel", "right-panel", "runtime", "settings"]},
    {"path": "app/shell/web-ui/nav", "kind": "ui-slot", "children": "fixed", "fixed": ["buttons"]},
    {"path": "app/shell/web-ui/nav/buttons", "kind": "ui-slot", "children": "keyed"},
    {"path": "app/shell/web-ui/chat", "kind": "ui-slot", "children": "fixed", "fixed": ["messages"]},
    {"path": "app/shell/web-ui/chat/messages", "kind": "ui-slot", "children": "fixed", "fixed": ["user_msg", "ai_msg", "tools"]},
    {"path": "app/shell/web-ui/chat/messages/tools", "kind": "ui-slot", "children": "keyed"},
    {"path": "app/shell/web-ui/actions", "kind": "ui-slot", "children": "keyed"},
    {"path": "app/shell/web-ui/input", "kind": "ui-slot", "children": "fixed", "fixed": ["textarea", "buttons", "right-buttons"]},
    {"path": "app/shell/web-ui/input/buttons", "kind": "ui-slot", "children": "keyed"},
    {"path": "app/shell/web-ui/input/right-buttons", "kind": "ui-slot", "children": "keyed"},
    {"path": "app/shell/web-ui/left-panel", "kind": "ui-slot", "children": "fixed", "fixed": ["sessions", "context_usage"]},
    {"path": "app/shell/web-ui/left-panel/sessions", "kind": "ui-slot", "children": "fixed", "fixed": ["new", "list"]},
    {"path": "app/shell/web-ui/left-panel/context_usage", "kind": "ui-slot", "children": "keyed"},
    {"path": "app/shell/web-ui/right-panel", "kind": "ui-slot", "children": "keyed"},
    {"path": "app/shell/web-ui/runtime", "kind": "ui-slot", "children": "fixed", "fixed": ["left-panel", "right-panel"]},
    {"path": "app/shell/web-ui/runtime/left-panel", "kind": "ui-slot", "children": "keyed"},
    {"path": "app/shell/web-ui/runtime/right-panel", "kind": "ui-slot", "children": "keyed"},
    {"path": "app/shell/web-ui/settings", "kind": "ui-slot", "children": "none"},
    {"path": "app/shell/web-ui/actions/settings_open", "kind": "ui-action", "props": {"label": "设置", "action": "settings.open"}},
    {"path": "app/shell/web-ui/actions/theme_toggle", "kind": "ui-action", "props": {"label": "主题切换", "action": "theme.toggle"}},
    {"path": "app/shell/web-ui/actions/auto_update_check", "kind": "ui-action", "props": {"label": "版本更新", "action": "auto_update.check"}},
    {"path": "app/shell/web-ui/actions/panel_open_file", "kind": "ui-action", "props": {"label": "打开文件", "action": "panel.open_file"}},
    {"path": "app/shell/web-ui/actions/panel_open", "kind": "ui-action", "props": {"label": "知识库", "action": "panel.open"}},
    {"path": "app/shell/web-ui/actions/visual_toggle", "kind": "ui-action", "props": {"label": "视觉切换", "action": "visual.toggle"}},
    {"path": "app/shell/web-ui/actions/input_mode", "kind": "ui-action", "props": {"label": "模式", "action": "input.mode"}},
    {"path": "app/shell/web-ui/actions/input_thinking", "kind": "ui-action", "props": {"label": "思考", "action": "input.thinking"}},
    {"path": "app/shell/web-ui/actions/input_goal", "kind": "ui-action", "props": {"label": "目标", "action": "input.goal"}},
    {"path": "app/shell/web-ui/actions/input_send", "kind": "ui-action", "props": {"label": "发送", "action": "input.send"}},
    {"path": "app/shell/web-ui/actions/input_stop", "kind": "ui-action", "props": {"label": "停止", "action": "input.stop"}},
    {"path": "app/shell/web-ui/right-panel/steps", "kind": "ui-control", "props": {"label": "步骤", "action": "panel.steps", "binding": {"tab": true, "skip_tab": true, "existing": ["#tabSteps", "#paneSteps"]}}, "order": 0},
    {"path": "app/shell/web-ui/right-panel/open_file", "kind": "ui-control", "props": {"label": "打开文件", "title": "打开文件", "action": "panel.open_file", "binding": {"skip_tab": true}}},
    {"path": "app/shell/web-ui/input/buttons/image_btn", "kind": "ui-control", "props": {"label": "图片", "action": "input.image", "binding": {"input": {"standalone": true, "target": "attachFile", "className": "mode-plus", "host": ".left-tools", "html": "<svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><rect x=\"3\" y=\"4\" width=\"15\" height=\"14\" rx=\"2\"/><circle cx=\"7.5\" cy=\"8.5\" r=\"1.4\"/><path d=\"m18 13-4.5-4L4 18\"/><path d=\"M19 15v6M16 18h6\"/></svg>"}}}, "order": 10},
    {"path": "app/shell/web-ui/input/buttons/mode_btn", "kind": "ui-control", "props": {"label": "Auto+", "action": "input.mode", "binding": {"input": {"standalone": true, "target": "modePlus", "className": "mode-plus", "action": "input.mode", "text": "Auto +", "host": ".left-tools"}}}, "order": 20},
    {"path": "app/shell/web-ui/input/buttons/thinking_btn", "kind": "ui-control", "props": {"label": "思考深度", "action": "input.thinking", "binding": {"input": {"standalone": true, "target": "reasoningBtn", "className": "mode-plus", "action": "input.thinking", "text": "思考深度·High", "host": ".left-tools"}}}, "order": 30},
    {"path": "app/shell/web-ui/input/right-buttons/goal_btn", "kind": "ui-control", "props": {"label": "目标", "action": "input.goal", "binding": {"input": {"standalone": true, "target": "autoToggle", "className": "mode-plus", "action": "input.goal", "text": "目标", "host": ".right-actions"}}}, "order": 10},
    {"path": "app/shell/web-ui/input/right-buttons/send_btn", "kind": "ui-control", "props": {"label": "发送", "action": "input.send", "binding": {"input": {"standalone": true, "target": "go", "className": "mode-plus", "action": "input.send", "text": "发送", "host": ".right-actions"}}}, "order": 20},
    {"path": "app/shell/web-ui/input/right-buttons/stop_btn", "kind": "ui-control", "props": {"label": "停止", "action": "input.stop", "binding": {"input": {"standalone": true, "target": "stopTask", "className": "mode-plus stop-task", "action": "input.stop", "text": "停止", "hidden": true, "host": ".right-actions"}}}, "order": 30},
    {"path": "app/shell/web-ui/runtime/left-panel/inbox", "kind": "ui-control", "props": {"label": "消息队列", "action": "runtime.inbox", "binding": {"existing": ["#chatQueue"]}}, "order": 0},
    {"path": "app/shell/web-ui/runtime/right-panel/background_task", "kind": "ui-control", "props": {"label": "后台任务", "action": "runtime.background", "binding": {"existing": ["#bgTaskPanel"]}}, "order": 0},
    {"path": "app/shell/web-ui/runtime/right-panel/subagent", "kind": "ui-control", "props": {"label": "子智能体", "action": "runtime.subagent", "binding": {"existing": ["#subagentPanel"]}}},
    {"path": "app/shell/web-ui/chat/messages/tools/diff", "kind": "ui-tool-shell", "props": {"label": "Diff", "renderer": "diff"}}
  ]
}